{% extends 'base.html.twig' %}
{% block title %}{{ 'home.meta.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="index,follow">{% endblock %}
{% block description %}<meta name="description" content="{{ 'home.meta.description'|trans }}">{% endblock %}
{% block canonical %}
  <link rel="canonical" href="{{ app.request.locale == 'pl' ? 'https://stackhal.com/pl/' : 'https://stackhal.com/' }}">
  <link rel="alternate" hreflang="en" href="https://stackhal.com/">
  <link rel="alternate" hreflang="pl" href="https://stackhal.com/pl/">
  <link rel="alternate" hreflang="x-default" href="https://stackhal.com/">
{% endblock %}

{% block body %}
<section class="hero toolbox-hero">
  <div class="eyebrow">{{ 'home.eyebrow'|trans }}</div>
  <h1>{{ 'home.heading_start'|trans }}</h1>
  <p class="lede">{{ 'home.lede'|trans }}</p>
  <div class="toolbox-orbit" aria-hidden="true">
    <span>DNS</span><span>CIDR</span><span>SEO</span><span>PKPass</span><span>Caddy</span>
    <strong>SH</strong>
  </div>
  <ul class="toolbox-status" aria-label="Toolbox characteristics">
    <li>Browser-first</li>
    <li>No signup</li>
    <li>Observable results</li>
  </ul>

  <div class="tool-catalog">
    <section class="tool-category" aria-labelledby="category-web">
      <header class="tool-category-header"><h2 id="category-web">{{ 'home.categories.web'|trans }}</h2></header>
      <div class="tool-grid">
        <a class="tool-card" href="{{ path('geo_home', {_locale: app.request.locale}) }}">
          <span class="tool-number">01</span>
          <h3>{{ 'home.geo.title'|trans }}</h3><p>{{ 'home.geo.text'|trans }}</p><strong>{{ 'home.open'|trans }} →</strong>
        </a>
        <a class="tool-card" href="{{ path('seo_audit_home', {_locale: app.request.locale}) }}">
          <span class="tool-number">02</span>
          <h3>{{ 'home.seo.title'|trans }}</h3><p>{{ 'home.seo.text'|trans }}</p><strong>{{ 'home.open'|trans }} →</strong>
        </a>
        <a class="tool-card" href="{{ path('favicon_suite', {_locale: app.request.locale}) }}">
          <span class="tool-number">03</span>
          <h3>{{ 'home.favicon_suite.title'|trans }}</h3><p>{{ 'home.favicon_suite.text'|trans }}</p><strong>{{ 'home.open'|trans }} →</strong>
        </a>
        <a class="tool-card" href="{{ path('cors_sandbox', {_locale: app.request.locale}) }}">
          <span class="tool-number">04</span>
          <h3>{{ 'home.cors_sandbox.title'|trans }}</h3><p>{{ 'home.cors_sandbox.text'|trans }}</p><strong>{{ 'home.open'|trans }} →</strong>
        </a>
      </div>
    </section>

    <section class="tool-category" aria-labelledby="category-email">
      <header class="tool-category-header"><h2 id="category-email">{{ 'home.categories.email'|trans }}</h2></header>
      <div class="tool-grid">
        <a class="tool-card" href="{{ path('bimi_studio', {_locale: app.request.locale}) }}">
          <span class="tool-number">05</span>
          <h3>{{ 'home.bimi.title'|trans }}</h3><p>{{ 'home.bimi.text'|trans }}</p><strong>{{ 'home.open'|trans }} →</strong>
        </a>
        <a class="tool-card" href="{{ path('domain_inspector_home', {_locale: app.request.locale}) }}">
          <span class="tool-number">06</span>
          <h3>{{ 'home.domain_inspector.title'|trans }}</h3><p>{{ 'home.domain_inspector.text'|trans }}</p><strong>{{ 'home.open'|trans }} →</strong>
        </a>
      </div>
    </section>

    <section class="tool-category" aria-labelledby="category-infrastructure">
      <header class="tool-category-header"><h2 id="category-infrastructure">{{ 'home.categories.infrastructure'|trans }}</h2></header>
      <div class="tool-grid">
        <a class="tool-card" href="{{ path('caddy_transpiler', {_locale: app.request.locale}) }}">
          <span class="tool-number">07</span>
          <h3>{{ 'home.caddy_transpiler.title'|trans }}</h3><p>{{ 'home.caddy_transpiler.text'|trans }}</p><strong>{{ 'home.open'|trans }} →</strong>
        </a>
        <a class="tool-card" href="{{ path('cidr_matrix', {_locale: app.request.locale}) }}">
          <span class="tool-number">08</span>
          <h3>{{ 'home.cidr_matrix.title'|trans }}</h3><p>{{ 'home.cidr_matrix.text'|trans }}</p><strong>{{ 'home.open'|trans }} →</strong>
        </a>
        <a class="tool-card" href="{{ path('regex_transpiler', {_locale: app.request.locale}) }}">
          <span class="tool-number">09</span>
          <h3>{{ 'home.regex_transpiler.title'|trans }}</h3><p>{{ 'home.regex_transpiler.text'|trans }}</p><strong>{{ 'home.open'|trans }} →</strong>
        </a>
        <a class="tool-card" href="{{ path('dns_dag_tracer', {_locale: app.request.locale}) }}">
          <span class="tool-number">10</span>
          <h3>{{ 'home.dns_dag_tracer.title'|trans }}</h3><p>{{ 'home.dns_dag_tracer.text'|trans }}</p><strong>{{ 'home.open'|trans }} →</strong>
        </a>
      </div>
    </section>

    <section class="tool-category" aria-labelledby="category-mobile">
      <header class="tool-category-header"><h2 id="category-mobile">{{ 'home.categories.mobile'|trans }}</h2></header>
      <div class="tool-grid">
        <a class="tool-card" href="{{ path('pkpass_inspector', {_locale: app.request.locale}) }}">
          <span class="tool-number">11</span>
          <h3>{{ 'home.pkpass.title'|trans }}</h3><p>{{ 'home.pkpass.text'|trans }}</p><strong>{{ 'home.open'|trans }} →</strong>
        </a>
        <a class="tool-card" href="{{ path('app_links_validator', {_locale: app.request.locale}) }}">
          <span class="tool-number">12</span>
          <h3>{{ 'home.app_links.title'|trans }}</h3><p>{{ 'home.app_links.text'|trans }}</p><strong>{{ 'home.open'|trans }} →</strong>
        </a>
      </div>
    </section>
  </div>


  <section class="toolbox-principles">
    <div><b>01</b><h2>{{ 'home.principles.private.title'|trans }}</h2><p>{{ 'home.principles.private.text'|trans }}</p></div>
    <div><b>02</b><h2>{{ 'home.principles.clear.title'|trans }}</h2><p>{{ 'home.principles.clear.text'|trans }}</p></div>
    <div><b>03</b><h2>{{ 'home.principles.fast.title'|trans }}</h2><p>{{ 'home.principles.fast.text'|trans }}</p></div>
  </section>
</section>
{% endblock %}
