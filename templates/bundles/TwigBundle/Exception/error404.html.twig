{% extends 'base.html.twig' %}

{% block title %}{{ 'error404.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex,nofollow">{% endblock %}

{% block stylesheets %}
<style>
  .error-hero-stackhal { max-width: 1280px; margin: 0 auto; padding: 64px 40px 80px; }
  .terminal-box { max-width: 720px; margin-bottom: 64px; }
  .terminal-badge { display: block; margin-bottom: 28px; color: var(--muted); font: 11px/1.6 var(--mono); letter-spacing: .015em; }
  .error-code-stackhal { margin-bottom: 20px; color: var(--ink); font: 500 clamp(64px, 11vw, 132px)/.95 var(--sans); letter-spacing: -.065em; }
  .error-code-stackhal span { color: var(--orange); }
  .error-title-stackhal { margin: 0 0 16px; font: 500 clamp(24px, 3vw, 34px)/1.1 var(--sans); letter-spacing: -.045em; }
  .error-p-stackhal { max-width: 520px; margin: 0 0 28px; color: var(--muted); font-size: 15px; line-height: 1.7; }
  .error-actions-stackhal { display: flex; flex-wrap: wrap; gap: 10px; }
  .btn-terminal-primary, .btn-terminal-secondary { display: inline-flex; align-items: center; gap: 18px; min-height: 48px; padding: 0 20px; border: 1px solid #202020; background: #202020; color: #fff; font: 500 14px var(--sans); text-decoration: none; }
  .btn-terminal-primary:hover { border-color: #a3261b; background: #a3261b; color: #fff; }
  .btn-terminal-secondary { border-color: var(--line); background: #fff; color: var(--ink); }
  .btn-terminal-secondary:hover { border-color: var(--ink); background: #f6f6f6; color: #a3261b; }
  .tools-catalog-title { display: block; margin-bottom: 20px; color: var(--muted); font: 11px var(--mono); letter-spacing: .04em; text-transform: uppercase; }
  .tools-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); column-gap: 36px; }
  .tool-tile { display: flex; flex-direction: column; gap: 6px; padding: 20px 0; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .tool-tile strong { font: 500 19px/1.15 var(--sans); letter-spacing: -.04em; }
  .tool-tile span { color: var(--muted); font-size: 13px; line-height: 1.5; }
  .tool-tile:hover strong { color: #a3261b; }
  @media (max-width: 600px) { .error-hero-stackhal { padding: 40px 20px 64px; } }
</style>
{% endblock %}

{% block body %}
<div class="error-hero-stackhal">
  <div class="terminal-box">
    <span class="terminal-badge">{{ 'error404.eyebrow'|trans }}</span>

    <div class="error-code-stackhal" aria-hidden="true">404<span>.</span></div>
    <h1 class="error-title-stackhal">{{ 'error404.heading'|trans }}</h1>
    <p class="error-p-stackhal">{{ 'error404.description'|trans }}</p>

    <div class="error-actions-stackhal">
      <a href="{{ path('landing', {_locale: app.request ? app.request.locale : 'en'}) }}" class="btn-terminal-primary">
        {{ 'common.all_tools'|trans }} <span aria-hidden="true">→</span>
      </a>
      <a href="{{ path('domain_inspector_home', {_locale: app.request ? app.request.locale : 'en'}) }}" class="btn-terminal-secondary">
        {{ 'error404.diagnostic_button'|trans }}
      </a>
    </div>
  </div>

  <div class="tools-catalog">
    <span class="tools-catalog-title">{{ 'error404.explore_heading'|trans }}</span>
    <div class="tools-grid">
      <a href="{{ path('caddy_transpiler', {_locale: app.request ? app.request.locale : 'en'}) }}" class="tool-tile">
        <strong>{{ 'base.nav.caddy_transpiler'|trans }}</strong>
        <span>{{ 'base.context.caddy_transpiler'|trans }}</span>
      </a>
      <a href="{{ path('cidr_matrix', {_locale: app.request ? app.request.locale : 'en'}) }}" class="tool-tile">
        <strong>{{ 'base.nav.cidr_matrix'|trans }}</strong>
        <span>{{ 'base.context.cidr_matrix'|trans }}</span>
      </a>
      <a href="{{ path('pkpass_inspector', {_locale: app.request ? app.request.locale : 'en'}) }}" class="tool-tile">
        <strong>{{ 'base.nav.pkpass'|trans }}</strong>
        <span>{{ 'base.context.pkpass'|trans }}</span>
      </a>
      <a href="{{ path('seo_audit_home', {_locale: app.request ? app.request.locale : 'en'}) }}" class="tool-tile">
        <strong>{{ 'base.nav.seo'|trans }}</strong>
        <span>{{ 'base.context.seo'|trans }}</span>
      </a>
      <a href="{{ path('bimi_studio', {_locale: app.request ? app.request.locale : 'en'}) }}" class="tool-tile">
        <strong>{{ 'base.nav.bimi'|trans }}</strong>
        <span>{{ 'base.context.bimi'|trans }}</span>
      </a>
      <a href="{{ path('cors_sandbox', {_locale: app.request ? app.request.locale : 'en'}) }}" class="tool-tile">
        <strong>{{ 'base.nav.cors_sandbox'|trans }}</strong>
        <span>{{ 'base.context.cors_sandbox'|trans }}</span>
      </a>
    </div>
  </div>
</div>
{% endblock %}
