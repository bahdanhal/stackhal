{% extends 'base.html.twig' %}
{% block title %}{{ 'dns_dag_tracer.meta.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="index,follow">{% endblock %}
{% block description %}<meta name="description" content="{{ 'dns_dag_tracer.meta.description'|trans }}">{% endblock %}
{% block canonical %}
  <link rel="canonical" href="{{ app.request.locale == 'pl' ? 'https://stackhal.com/pl/tracer-dns-dag' : 'https://stackhal.com/dns-dag-tracer' }}">
  <link rel="alternate" hreflang="en" href="https://stackhal.com/dns-dag-tracer">
  <link rel="alternate" hreflang="pl" href="https://stackhal.com/pl/tracer-dns-dag">
  <link rel="alternate" hreflang="x-default" href="https://stackhal.com/dns-dag-tracer">
{% endblock %}
{% block stylesheets %}
  <link rel="stylesheet" href="/tools.css">
{% endblock %}
{% block language_switch %}
  <a class="language-switch" href="{{ path('dns_dag_tracer', {_locale: app.request.locale == 'pl' ? 'en' : 'pl'}) }}" hreflang="{{ app.request.locale == 'pl' ? 'en' : 'pl' }}">{{ app.request.locale == 'pl' ? 'EN' : 'PL' }}</a>
{% endblock %}
{% block tool_name %}{{ 'dns_dag_tracer.heading'|trans }}{% endblock %}

{% block body %}
<section class="tool-page-shell dns-dag-shell">
  {% include 'tools/_tool_intro.html.twig' with {
    eyebrow: 'dns_dag_tracer.eyebrow'|trans,
    heading: 'dns_dag_tracer.heading'|trans,
    lede: 'dns_dag_tracer.lede'|trans
  } only %}

  <div class="transpiler-container" id="dns-dag-app" data-locale="{{ app.request.locale }}">
    <!-- Presets Toolbar -->
    <div class="transpiler-toolbar ui-panel">
      <div class="preset-group">
        <span class="preset-label">{{ 'dns_dag_tracer.presets_label'|trans }}:</span>
        {% for preset in presets %}
          <button type="button" class="btn-preset" data-domain="{{ preset.domain }}" data-query-type="{{ preset.query_type }}">
            {{ preset.domain }} ({{ preset.query_type }})
          </button>
        {% endfor %}
      </div>
    </div>

    <!-- Query Input Form -->
    <div class="ui-panel" style="padding: 1.5rem; margin-bottom: 1.5rem;">
      <form method="post" action="{{ path('dns_dag_tracer', {_locale: app.request.locale}) }}" id="dns-form">
        <div style="display: grid; grid-template-columns: 2fr 1fr auto; gap: 1rem; align-items: flex-end;">
          <div>
            <label for="domain-input" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">{{ 'dns_dag_tracer.domain_label'|trans }}</label>
            <input type="text" name="domain" id="domain-input" value="{{ domain }}" placeholder="example.com" required style="width: 100%; padding: 0.6rem; background: var(--bg-surface, #1e293b); color: inherit; border: 1px solid var(--border-color, #334155); border-radius: 4px; font-family: monospace;">
          </div>
          <div>
            <label for="query-type-select" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">{{ 'dns_dag_tracer.record_type_label'|trans }}</label>
            <select name="query_type" id="query-type-select" style="width: 100%; padding: 0.6rem; background: var(--bg-surface, #1e293b); color: inherit; border: 1px solid var(--border-color, #334155); border-radius: 4px;">
              {% for qt in ['A', 'AAAA', 'CNAME', 'TXT', 'MX', 'NS', 'SOA', 'CAA', 'DS', 'DNSKEY'] %}
                <option value="{{ qt }}" {% if query_type == qt %}selected{% endif %}>{{ qt }}</option>
              {% endfor %}
            </select>
          </div>
          <div>
            <button type="submit" class="btn-submit" style="padding: 0.6rem 1.5rem; background: #2563eb; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">{{ 'dns_dag_tracer.trace_btn'|trans }}</button>
          </div>
        </div>
      </form>
    </div>

    <!-- Trace Summary Badges -->
    <div class="ui-panel" style="padding: 1rem 1.5rem; margin-bottom: 1.5rem; display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center;">
      <div>
        <span style="font-size: 0.8rem; color: #94a3b8; display: block;">Status</span>
        <span style="font-weight: 700; text-transform: uppercase; padding: 2px 8px; border-radius: 4px; font-size: 0.85rem; background: {% if result.status == 'healthy' %}#14532d{% elseif result.status == 'warning' %}#78350f{% else %}#7f1d1d{% endif %}; color: #fff;">
          {{ result.status }}
        </span>
      </div>

      <div>
        <span style="font-size: 0.8rem; color: #94a3b8; display: block;">DNSSEC</span>
        <span style="font-weight: 700; text-transform: uppercase; padding: 2px 8px; border-radius: 4px; font-size: 0.85rem; background: {% if result.dnssecStatus.value == 'secure' %}#1e3a8a{% elseif result.dnssecStatus.value == 'bogus' %}#7f1d1d{% else %}#334155{% endif %}; color: #fff;">
          {{ result.dnssecStatus.value }}
        </span>
      </div>

      <div>
        <span style="font-size: 0.8rem; color: #94a3b8; display: block;">Hierarchy Depth</span>
        <span style="font-weight: 700;">{{ result.layerCount }} Layers</span>
      </div>

      <div>
        <span style="font-size: 0.8rem; color: #94a3b8; display: block;">Global Propagation</span>
        <span style="font-weight: 700; color: {% if result.hasDivergence %}#f59e0b{% else %}#22c55e{% endif %};">
          {% if result.hasDivergence %}Divergence Detected{% else %}Consistent Across Edge{% endif %}
        </span>
      </div>
    </div>

    <!-- 4-Layer Delegation DAG Visualization -->
    <div class="ui-panel" style="padding: 1.5rem; margin-bottom: 1.5rem;">
      <h3 style="margin-top: 0; margin-bottom: 1.5rem;">{{ 'dns_dag_tracer.dag_title'|trans }}</h3>

      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        {% for layer in result.layers %}
          <div style="background: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 1.25rem; position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid #1e293b; padding-bottom: 0.5rem;">
              <div>
                <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #38bdf8; font-weight: 700;">Layer {{ layer.layer }}: {{ layer.name|upper }}</span>
                <h4 style="margin: 0.2rem 0 0; font-size: 1.1rem;">{{ layer.label }}</h4>
              </div>
              <span style="font-size: 0.8rem; color: #94a3b8;">{{ layer.servers }}</span>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem;">
              {% for node in layer.nodes %}
                <div style="background: #1e293b; border: 1px solid #334155; border-radius: 6px; padding: 0.75rem;">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <strong style="font-family: monospace; font-size: 0.9rem;">{{ node.serverName }}</strong>
                    <span style="font-size: 0.75rem; color: #94a3b8;">{{ node.latencyMs }}ms</span>
                  </div>
                  <div style="font-size: 0.8rem; color: #64748b; font-family: monospace; margin-bottom: 0.5rem;">IP: {{ node.serverIp }}</div>
                  
                  <div style="background: #090a0f; border-radius: 4px; padding: 0.5rem; font-family: monospace; font-size: 0.8rem;">
                    {% if node.answers is not empty %}
                      {% for ans in node.answers %}
                        <div style="color: #22c55e;">{{ ans }}</div>
                      {% endfor %}
                    {% else %}
                      <div style="color: #94a3b8; font-style: italic;">(No resource records returned)</div>
                    {% endif %}
                  </div>

                  <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #94a3b8; margin-top: 0.5rem;">
                    <span>TTL: {{ node.ttl }}s</span>
                    {% if node.soaSerial %}
                      <span>SOA: {{ node.soaSerial }}</span>
                    {% endif %}
                    <span style="color: {% if node.rcode == 'NOERROR' %}#22c55e{% else %}#ef4444{% endif %}; font-weight: 600;">{{ node.rcode }}</span>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
          {% if not loop.last %}
            <div style="text-align: center; font-size: 1.25rem; color: #38bdf8; margin: -0.5rem 0;">↓</div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Diagnostics List -->
    {% if result.diagnostics is not empty %}
      <div class="ui-panel" style="padding: 1.5rem; margin-bottom: 1.5rem;">
        <h3 style="margin-top: 0; margin-bottom: 1rem;">{{ 'dns_dag_tracer.diagnostics_title'|trans }}</h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          {% for diag in result.diagnostics %}
            <div style="padding: 0.75rem 1rem; border-radius: 6px; font-size: 0.9rem; background: {% if diag.severity == 'error' %}#451a1a{% elseif diag.severity == 'warning' %}#422006{% else %}#172554{% endif %}; border: 1px solid {% if diag.severity == 'error' %}#dc2626{% elseif diag.severity == 'warning' %}#d97706{% else %}#2563eb{% endif %};">
              <strong>[{{ diag.code }}]</strong> {{ diag.title }}: {{ diag.description }}
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <!-- FAQ Section -->
    <section class="transpiler-faq ui-panel">
      <div class="section-title-wrap">
        <h2>{{ 'dns_dag_tracer.faq.title'|trans }}</h2>
      </div>
      <div class="faq-list">
        {% for idx in ['q1', 'q2', 'q3', 'q4'] %}
          <details class="faq-item" {% if loop.first %}open{% endif %}>
            <summary class="faq-question"><strong>{{ ('dns_dag_tracer.faq.' ~ idx)|trans }}</strong></summary>
            <div class="faq-answer">
              <p>{{ ('dns_dag_tracer.faq.' ~ idx ~ '_a')|trans }}</p>
            </div>
          </details>
        {% endfor %}
      </div>
    </section>
  </div>
</section>
{% endblock %}

{% block scripts %}
  <script src="/dns-dag-tracer.js"></script>
{% endblock %}
