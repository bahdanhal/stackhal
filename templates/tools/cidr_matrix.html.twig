{% extends 'base.html.twig' %}
{% block title %}{{ 'cidr_matrix.meta.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="index,follow">{% endblock %}
{% block description %}<meta name="description" content="{{ 'cidr_matrix.meta.description'|trans }}">{% endblock %}
{% block canonical %}
  <link rel="canonical" href="{{ app.request.locale == 'pl' ? 'https://stackhal.com/pl/matryca-cidr' : 'https://stackhal.com/cidr-subnet-matrix' }}">
  <link rel="alternate" hreflang="en" href="https://stackhal.com/cidr-subnet-matrix">
  <link rel="alternate" hreflang="pl" href="https://stackhal.com/pl/matryca-cidr">
  <link rel="alternate" hreflang="x-default" href="https://stackhal.com/cidr-subnet-matrix">
{% endblock %}
{% block stylesheets %}
  <link rel="stylesheet" href="/tools.css">
  <link rel="stylesheet" href="/cidr-matrix.css">
{% endblock %}
{% block head_scripts %}
  <script type="application/ld+json">{{ {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebApplication',
        '@id': (app.request.locale == 'pl' ? 'https://stackhal.com/pl/matryca-cidr#app' : 'https://stackhal.com/cidr-subnet-matrix#app'),
        'name': 'cidr_matrix.heading'|trans,
        'description': 'cidr_matrix.meta.description'|trans,
        'url': (app.request.locale == 'pl' ? 'https://stackhal.com/pl/matryca-cidr' : 'https://stackhal.com/cidr-subnet-matrix'),
        'applicationCategory': 'DeveloperApplication',
        'operatingSystem': 'Any',
        'offers': {
          '@type': 'Offer',
          'price': '0',
          'priceCurrency': 'USD'
        },
        'author': {'@id': 'https://stackhal.com/#stackhal'},
        'publisher': {'@id': 'https://stackhal.com/#stackhal'}
      }
    ]
  }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}
{% block language_switch %}
  <a class="language-switch" href="{{ path('cidr_matrix', {_locale: app.request.locale == 'pl' ? 'en' : 'pl'}) }}" hreflang="{{ app.request.locale == 'pl' ? 'en' : 'pl' }}">{{ app.request.locale == 'pl' ? 'EN' : 'PL' }}</a>
{% endblock %}
{% block tool_name %}{{ 'cidr_matrix.heading'|trans }}{% endblock %}

{% block body %}
<section class="tool-page-shell cidr-matrix-shell">
  {% include 'tools/_tool_intro.html.twig' with {
    eyebrow: 'cidr_matrix.eyebrow'|trans,
    heading: 'cidr_matrix.heading'|trans,
    lede: 'cidr_matrix.lede'|trans
  } only %}

  <div class="cidr-matrix-container" style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-top: 2rem;">
    <div class="cidr-input-card card" style="background: var(--surface-card, #1e293b); padding: 1.5rem; border-radius: 0.75rem;">
      <h2>{{ 'cidr_matrix.form.title'|trans }}</h2>
      <p style="color: var(--text-muted, #94a3b8); margin-bottom: 1rem;">{{ 'cidr_matrix.form.help'|trans }}</p>

      {% if presets|length > 0 %}
        <div class="preset-buttons" style="margin-bottom: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
          <span style="align-self: center; font-weight: 600; font-size: 0.875rem;">{{ 'cidr_matrix.form.presets'|trans }}:</span>
          {% for preset in presets %}
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('cidrs-textarea').value = '{{ preset.cidrs|join(', ') }}'; document.getElementById('cidr-form').submit();" style="cursor: pointer; padding: 0.35rem 0.75rem; border-radius: 0.375rem; font-size: 0.85rem;">
              {{ preset.name }}
            </button>
          {% endfor %}
        </div>
      {% endif %}

      <form id="cidr-form" method="post" action="{{ path('cidr_matrix', {_locale: app.request.locale}) }}">
        <div class="form-group" style="margin-bottom: 1.25rem;">
          <label for="cidrs-textarea" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">{{ 'cidr_matrix.form.label_cidrs'|trans }}</label>
          <textarea id="cidrs-textarea" name="cidrs" rows="4" style="width: 100%; font-family: monospace; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #334155; background: #0f172a; color: #f8fafc;" placeholder="e.g. 10.0.0.0/16, 10.0.32.0/20, 192.168.1.0/24">{{ raw_cidrs }}</textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
          <div class="form-group">
            <label for="parent-cidr" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">{{ 'cidr_matrix.form.label_parent'|trans }}</label>
            <input type="text" id="parent-cidr" name="parent_cidr" value="{{ parent_cidr }}" placeholder="e.g. 10.0.0.0/16" style="width: 100%; font-family: monospace; padding: 0.6rem; border-radius: 0.5rem; border: 1px solid #334155; background: #0f172a; color: #f8fafc;">
          </div>
          <div class="form-group">
            <label for="free-prefix" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">{{ 'cidr_matrix.form.label_free_prefix'|trans }}</label>
            <input type="number" id="free-prefix" name="requested_free_prefix" value="{{ requested_free_prefix }}" min="0" max="128" placeholder="e.g. 20 or 24" style="width: 100%; font-family: monospace; padding: 0.6rem; border-radius: 0.5rem; border: 1px solid #334155; background: #0f172a; color: #f8fafc;">
          </div>
        </div>

        <button type="submit" class="btn btn-primary" style="padding: 0.75rem 1.5rem; background: #3b82f6; color: #ffffff; border: none; border-radius: 0.5rem; font-weight: 600; cursor: pointer;">
          {{ 'cidr_matrix.form.submit'|trans }}
        </button>
      </form>
    </div>

    {% if result is not null %}
      <div class="cidr-results-card card" style="background: var(--surface-card, #1e293b); padding: 1.5rem; border-radius: 0.75rem;">
        <h2>{{ 'cidr_matrix.results.title'|trans }}</h2>

        {% if result.diagnostics|length > 0 %}
          <div class="diagnostics-list" style="margin-bottom: 1.5rem;">
            {% for diag in result.diagnostics %}
              <div class="alert alert-{{ diag.severity == 'error' ? 'danger' : (diag.severity == 'warning' ? 'warning' : 'info') }}" style="padding: 1rem; border-radius: 0.5rem; margin-bottom: 0.75rem; border-left: 4px solid {{ diag.severity == 'error' ? '#ef4444' : (diag.severity == 'warning' ? '#f59e0b' : '#3b82f6') }}; background: #0f172a;">
                <strong style="text-transform: uppercase; font-size: 0.75rem; display: block; color: {{ diag.severity == 'error' ? '#f87171' : (diag.severity == 'warning' ? '#fbbf24' : '#60a5fa') }};">{{ diag.code }}</strong>
                <h4 style="margin: 0.25rem 0 0.5rem 0;">{{ diag.title }}</h4>
                <p style="margin: 0; font-size: 0.9rem;">{{ diag.description }}</p>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if result.freeSubnetCidr is not null %}
          <div class="free-subnet-box" style="padding: 1rem; background: #064e3b; border: 1px solid #10b981; border-radius: 0.5rem; margin-bottom: 1.5rem;">
            <h3 style="margin-top: 0; color: #a7f3d0;">{{ 'cidr_matrix.results.free_subnet_title'|trans }}</h3>
            <p style="margin: 0; font-size: 1.25rem; font-family: monospace; font-weight: bold; color: #34d399;">
              {{ result.freeSubnetCidr }}
            </p>
          </div>
        {% endif %}

        {% if result.collisions|length > 0 %}
          <div class="collisions-section" style="margin-bottom: 1.5rem;">
            <h3>{{ 'cidr_matrix.results.collisions_title'|trans }} ({{ result.collisionCount }})</h3>
            <table class="table" style="width: 100%; border-collapse: collapse; margin-top: 0.5rem;">
              <thead>
                <tr style="border-bottom: 1px solid #334155; text-align: left;">
                  <th style="padding: 0.5rem;">{{ 'cidr_matrix.table.subnet_a'|trans }}</th>
                  <th style="padding: 0.5rem;">{{ 'cidr_matrix.table.subnet_b'|trans }}</th>
                  <th style="padding: 0.5rem;">{{ 'cidr_matrix.table.overlap_range'|trans }}</th>
                </tr>
              </thead>
              <tbody>
                {% for col in result.collisions %}
                  <tr style="border-bottom: 1px solid #1e293b;">
                    <td style="padding: 0.5rem; font-family: monospace; color: #f87171;">{{ col.cidrA }}</td>
                    <td style="padding: 0.5rem; font-family: monospace; color: #f87171;">{{ col.cidrB }}</td>
                    <td style="padding: 0.5rem; font-family: monospace; color: #fbbf24;">{{ col.startIp }} - {{ col.endIp }} ({{ col.overlapCidr }})</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}

        {% if result.matrixGrid|length > 0 %}
          <div class="cidr-visual-workspace">
            <div class="cidr-matrix-legend">
              <strong style="color: #f8fafc;">{{ 'cidr_matrix.results.legend.title'|trans }}:</strong>
              <div class="legend-item"><span class="legend-chip assigned"></span> {{ 'cidr_matrix.results.legend.assigned'|trans }}</div>
              <div class="legend-item"><span class="legend-chip collision"></span> {{ 'cidr_matrix.results.legend.collision'|trans }}</div>
              <div class="legend-item"><span class="legend-chip containment"></span> {{ 'cidr_matrix.results.legend.containment'|trans }}</div>
              <div class="legend-item"><span class="legend-chip recommended"></span> {{ 'cidr_matrix.results.legend.recommended'|trans }}</div>
              <div class="legend-item"><span class="legend-chip disjoint"></span> {{ 'cidr_matrix.results.legend.disjoint'|trans }}</div>
            </div>

            <div class="cidr-tabs-nav" role="tablist">
              <button type="button" class="cidr-tab-btn active" data-tab="tab-space-map" role="tab">
                <span>🗺️</span> {{ 'cidr_matrix.results.tabs.space_map'|trans }}
              </button>
              <button type="button" class="cidr-tab-btn" data-tab="tab-cross-matrix" role="tab">
                <span>🔢</span> {{ 'cidr_matrix.results.tabs.cross_matrix'|trans }}
              </button>
              <button type="button" class="cidr-tab-btn" data-tab="tab-partition-tree" role="tab">
                <span>🌳</span> {{ 'cidr_matrix.results.tabs.tree_view'|trans }}
              </button>
            </div>

            <!-- Tab 1: 2D Address Space Map & Proportional Treemap -->
            <div id="tab-space-map" class="cidr-tab-pane active" role="tabpanel">
              <div class="cidr-space-map">
                {% if result.spacePartitions|length > 0 %}
                  <div class="cidr-allocation-bar-wrapper">
                    <div class="cidr-allocation-bar-header">
                      <strong>{{ 'cidr_matrix.results.allocation_bar_title'|trans }}</strong>
                      <span>{{ 'cidr_matrix.results.interactive_tip'|trans }}</span>
                    </div>
                    <div class="cidr-allocation-bar">
                      {% for part in result.spacePartitions %}
                        <div class="cidr-bar-segment {{ part.type }}" style="flex: {{ part.percentage }} 0 auto; min-width: 48px;" title="{{ part.cidr }} ({{ part.status_label }}) - {{ part.network_ip }} .. {{ part.broadcast_ip }} [{{ part.total_hosts }} hosts]">
                          {{ part.cidr }}
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                {% endif %}

                <div class="cidr-treemap-grid">
                  {% for part in result.spacePartitions %}
                    <div class="cidr-map-card {{ part.type }}">
                      <div class="cidr-map-card-header">
                        <span class="cidr-map-title">{{ part.cidr }}</span>
                        <span class="cidr-badge {{ part.type }}">{{ part.status_label }}</span>
                      </div>
                      <div class="cidr-map-meta">
                        <div><strong>Range:</strong> <code>{{ part.network_ip }} - {{ part.broadcast_ip }}</code></div>
                        <div><strong>Prefix:</strong> /{{ part.prefix_length }} (<strong>{{ part.total_hosts }}</strong> hosts)</div>
                        <div><strong>Address Space Weight:</strong> ~{{ part.percentage }}%</div>
                      </div>
                      {% if part.conflicting_cidrs|length > 0 %}
                        <div class="cidr-collision-alert">
                          ⚠️ Collides with: <strong>{{ part.conflicting_cidrs|join(', ') }}</strong>
                        </div>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>

            <!-- Tab 2: NxN Pairwise Cross-Overlap Matrix -->
            <div id="tab-cross-matrix" class="cidr-tab-pane" role="tabpanel">
              <div class="cidr-matrix-table-wrapper">
                <div style="margin-bottom: 0.75rem; font-size: 0.85rem; color: #94a3b8;">
                  <strong>{{ 'cidr_matrix.results.matrix_table_title'|trans }}</strong> &mdash; {{ 'cidr_matrix.results.interactive_tip'|trans }}
                </div>
                <table class="cidr-matrix-table">
                  <thead>
                    <tr>
                      <th class="row-label">CIDR \ CIDR</th>
                      {% for h in result.pairwiseMatrix.headers %}
                        <th data-col-header="{{ h.index }}">{{ h.label }}</th>
                      {% endfor %}
                    </tr>
                  </thead>
                  <tbody>
                    {% for row in result.pairwiseMatrix.rows %}
                      <tr>
                        <th class="row-label" data-row-header="{{ row.index }}">{{ row.label }}</th>
                        {% for cell in row.cells %}
                          <td class="matrix-cell status-{{ cell.status }}"
                              data-row="{{ cell.row_idx }}"
                              data-col="{{ cell.col_idx }}"
                              data-badge="{{ cell.badge }}"
                              data-desc="{{ cell.description }}"
                              data-row-cidr="{{ row.cidr }}"
                              data-col-cidr="{{ result.pairwiseMatrix.headers[cell.col_idx].cidr }}"
                              title="{{ cell.description }}">
                            {{ cell.badge }}
                          </td>
                        {% endfor %}
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
                <div id="matrix-cell-info-display" class="matrix-cell-info">
                  <em>{{ 'cidr_matrix.results.interactive_tip'|trans }}</em>
                </div>
              </div>
            </div>

            <!-- Tab 3: Subnet Partition Tree -->
            <div id="tab-partition-tree" class="cidr-tab-pane" role="tabpanel">
              <div class="cidr-tree-view">
                <h4 style="margin-top: 0; margin-bottom: 1rem;">{{ 'cidr_matrix.results.tree_view_title'|trans }}</h4>
                {% for node in result.treeNodes %}
                  <div class="tree-node">
                    <div class="tree-card {{ node.type == 'parent' ? 'root' : 'child' }}">
                      <span style="font-weight: bold; color: {{ node.type == 'parent' ? '#60a5fa' : '#f8fafc' }};">{{ node.cidr }}</span>
                      <span style="color: #94a3b8; font-size: 0.8rem;">(<code>{{ node.network_ip }} - {{ node.broadcast_ip }}</code> &bull; {{ node.total_hosts }} hosts)</span>
                    </div>
                    {% if node.children|length > 0 %}
                      <div class="tree-children">
                        {% for child in node.children %}
                          <div class="tree-card {{ child.type == 'recommended_free' ? 'recommended' : 'child' }}">
                            <span style="font-weight: bold; color: {{ child.type == 'recommended_free' ? '#34d399' : (child.type == 'contained' ? '#fbbf24' : '#93c5fd') }};">{{ child.cidr }}</span>
                            <span style="color: #94a3b8; font-size: 0.8rem;">(<code>{{ child.network_ip }} - {{ child.broadcast_ip }}</code> &bull; {{ child.total_hosts }} hosts)</span>
                            {% if child.type == 'recommended_free' %}
                              <span class="cidr-badge recommended_free">{{ 'cidr_matrix.results.legend.recommended'|trans }}</span>
                            {% elseif child.type == 'contained' %}
                              <span class="cidr-badge" style="background: #78350f; color: #fde68a;">{{ 'cidr_matrix.results.legend.containment'|trans }}</span>
                            {% endif %}
                          </div>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <section class="cidr-matrix-faq" style="margin-top: 2rem;">
      <h2>{{ 'cidr_matrix.faq.title'|trans }}</h2>
      <details style="margin-bottom: 1rem; background: #1e293b; padding: 1rem; border-radius: 0.5rem;">
        <summary style="font-weight: 600; cursor: pointer;">{{ 'cidr_matrix.faq.q1'|trans }}</summary>
        <p style="margin-top: 0.5rem; color: #94a3b8;">{{ 'cidr_matrix.faq.a1'|trans }}</p>
      </details>
      <details style="margin-bottom: 1rem; background: #1e293b; padding: 1rem; border-radius: 0.5rem;">
        <summary style="font-weight: 600; cursor: pointer;">{{ 'cidr_matrix.faq.q2'|trans }}</summary>
        <p style="margin-top: 0.5rem; color: #94a3b8;">{{ 'cidr_matrix.faq.a2'|trans }}</p>
      </details>
    </section>
  </div>
</section>
<script src="/cidr-matrix.js" defer></script>
{% endblock %}
