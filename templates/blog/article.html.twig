{% extends 'blog/base.html.twig' %}
{% block title %}{{ article.title }} · StackHal{% endblock %}
{% block robots %}<meta name="robots" content="index,follow">{% endblock %}
{% block description %}<meta name="description" content="{{ article.description }}">{% endblock %}
{% block canonical %}
  {% if article.alternateSlug %}
    {% if app.request.locale == 'pl' %}
      <link rel="canonical" href="https://stackhal.com/pl/blog/{{ article.slug }}">
      <link rel="alternate" hreflang="pl" href="https://stackhal.com/pl/blog/{{ article.slug }}">
      <link rel="alternate" hreflang="en" href="https://stackhal.com/blog/{{ article.alternateSlug }}">
      <link rel="alternate" hreflang="x-default" href="https://stackhal.com/blog/{{ article.alternateSlug }}">
    {% else %}
      <link rel="canonical" href="https://stackhal.com/blog/{{ article.slug }}">
      <link rel="alternate" hreflang="en" href="https://stackhal.com/blog/{{ article.slug }}">
      <link rel="alternate" hreflang="pl" href="https://stackhal.com/pl/blog/{{ article.alternateSlug }}">
      <link rel="alternate" hreflang="x-default" href="https://stackhal.com/blog/{{ article.slug }}">
    {% endif %}
  {% else %}
    <link rel="canonical" href="https://stackhal.com/blog/{{ article.slug }}">
    <link rel="alternate" hreflang="en" href="https://stackhal.com/blog/{{ article.slug }}">
    <link rel="alternate" hreflang="x-default" href="https://stackhal.com/blog/{{ article.slug }}">
  {% endif %}
{% endblock %}
{% block head_scripts %}
  {{ parent() }}
  {% set article_url = app.request.locale == 'pl' ? ('https://stackhal.com/pl/blog/' ~ article.slug) : ('https://stackhal.com/blog/' ~ article.slug) %}
  {% set article_schema = {'@type': 'Article', '@id': article_url ~ '#article', 'headline': article.title, 'description': article.description, 'datePublished': article.publishedAt|date('Y-m-d'), 'dateModified': article.updatedAt|date('Y-m-d'), 'author': {'@id': 'https://stackhal.com/#stackhal'}, 'publisher': {'@id': 'https://stackhal.com/#stackhal'}, 'mainEntityOfPage': article_url, 'inLanguage': app.request.locale} %}
  {% set graph = [article_schema] %}
  {% if article.howToSteps is not empty %}
    {% set graph = graph|merge([{'@type': 'HowTo', '@id': article_url ~ '#howto', 'name': article.title, 'step': article.howToSteps|map(step => {'@type': 'HowToStep', 'name': step.name, 'text': step.text})}]) %}
  {% endif %}
  <script type="application/ld+json">{{ {'@context': 'https://schema.org', '@graph': graph}|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}
{% block language_switch %}
  {% if article.alternateSlug %}
    {% if app.request.locale == 'pl' %}
      <a class="language-switch" href="{{ path('blog_article', {'slug': article.alternateSlug, '_locale': 'en'}) }}" hreflang="en">EN</a>
    {% else %}
      <a class="language-switch" href="{{ path('blog_article', {'slug': article.alternateSlug, '_locale': 'pl'}) }}" hreflang="pl">PL</a>
    {% endif %}
  {% else %}
    <a class="language-switch" href="{{ path('landing', {'_locale': app.request.locale == 'pl' ? 'en' : 'pl'}) }}" hreflang="{{ app.request.locale == 'pl' ? 'en' : 'pl' }}">{{ app.request.locale == 'pl' ? 'EN' : 'PL' }}</a>
  {% endif %}
{% endblock %}
{% block body %}
<article class="article-shell">
  <nav class="journal-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ path('blog_index', {_locale: app.request.locale}) }}">← All field notes</a>
    <span>StackHal / Blog</span>
  </nav>
  <header class="article-header">
    <div class="article-heading-copy">
      <p class="article-kicker">{{ article.category|upper }} · {{ article.readTimeMinutes }} MIN READ · {{ article.publishedAt|date('F d, Y')|upper }}</p>
      <h1>{{ article.title }}</h1>
      <p class="article-dek">{{ article.description }}</p>
      <div class="article-header-meta">
        <span>By <a href="https://bahdanhal.pl/">Bahdan Hal</a></span>
        <span>Updated <time datetime="{{ article.updatedAt|date('Y-m-d') }}">{{ article.updatedAt|date('F d, Y') }}</time></span>
      </div>
    </div>
  </header>
  <div class="article-layout">
    {% set externalCta = article.ctaPath starts with 'https://' %}
    <div class="article-prose article-content" id="article-content">{{ article.contentHtml|raw }}</div>
    <aside class="article-sidebar">
      <nav class="article-toc" aria-label="On this page">
        <span>IN THIS NOTE</span>
        <div data-article-sections></div>
        <a href="#article-cta">Related tool ↗</a>
      </nav>
      <div class="article-cta-card" id="article-cta">
        <p class="article-kicker">RELATED TOOL</p>
        <h2>Put it to work.</h2>
        <p>Continue with the tool behind this note.</p>
        <a class="cta-button" href="{{ article.ctaPath }}"{% if externalCta %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ article.ctaLabel }}</a>
      </div>
      <div class="article-author-card">
        <p class="article-kicker">STACKHAL FIELD NOTES</p>
        <p>Investigations and practical guides by <a href="https://bahdanhal.pl/">Bahdan Hal</a>.</p>
      </div>
    </aside>
  </div>
  <div class="journal-colophon">
    <a href="{{ path('blog_index', {_locale: app.request.locale}) }}">← Back to the archive</a>
    <span>StackHal / Field notes</span>
  </div>
</article>
{% endblock %}
