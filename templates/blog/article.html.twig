{% extends 'base.html.twig' %}
{% block title %}{{ article.title }} · StackHal{% endblock %}
{% block robots %}<meta name="robots" content="index,follow">{% endblock %}
{% block description %}<meta name="description" content="{{ article.description }}">{% endblock %}
{% block canonical %}
  {% if app.request.locale == 'pl' %}
    <link rel="canonical" href="https://stackhal.com/pl/blog/{{ article.slug }}">
    <link rel="alternate" hreflang="pl" href="https://stackhal.com/pl/blog/{{ article.slug }}">
    {% if article.alternateSlug %}
      <link rel="alternate" hreflang="en" href="https://stackhal.com/blog/{{ article.alternateSlug }}">
      <link rel="alternate" hreflang="x-default" href="https://stackhal.com/blog/{{ article.alternateSlug }}">
    {% else %}
      <link rel="alternate" hreflang="en" href="https://stackhal.com/blog/{{ article.slug }}">
      <link rel="alternate" hreflang="x-default" href="https://stackhal.com/blog/{{ article.slug }}">
    {% endif %}
  {% else %}
    <link rel="canonical" href="https://stackhal.com/blog/{{ article.slug }}">
    <link rel="alternate" hreflang="en" href="https://stackhal.com/blog/{{ article.slug }}">
    {% if article.alternateSlug %}
      <link rel="alternate" hreflang="pl" href="https://stackhal.com/pl/blog/{{ article.alternateSlug }}">
    {% endif %}
    <link rel="alternate" hreflang="x-default" href="https://stackhal.com/blog/{{ article.slug }}">
  {% endif %}
{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/blog.css?v=20260830163000">{% endblock %}
{% block head_scripts %}
  {% set article_schema = {'@type': 'Article', '@id': 'https://stackhal.com/blog/' ~ article.slug ~ '#article', 'headline': article.title, 'description': article.description, 'datePublished': article.publishedAt|date('Y-m-d'), 'dateModified': article.updatedAt|date('Y-m-d'), 'author': {'@id': 'https://stackhal.com/#stackhal'}, 'publisher': {'@id': 'https://stackhal.com/#stackhal'}, 'mainEntityOfPage': 'https://stackhal.com/blog/' ~ article.slug, 'inLanguage': app.request.locale} %}
  {% set graph = [article_schema] %}
  {% if article.howToSteps is not empty %}
    {% set graph = graph|merge([{'@type': 'HowTo', '@id': 'https://stackhal.com/blog/' ~ article.slug ~ '#howto', 'name': article.title, 'step': article.howToSteps|map(step => {'@type': 'HowToStep', 'name': step.name, 'text': step.text})}]) %}
  {% endif %}
  <script type="application/ld+json">{{ {'@context': 'https://schema.org', '@graph': graph}|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}
{% block language_switch %}
  {% if app.request.locale == 'pl' %}
    <a class="language-switch" href="{{ path('blog_article', {'slug': article.alternateSlug ?: article.slug, '_locale': 'en'}) }}" hreflang="en">EN</a>
  {% else %}
    <a class="language-switch" href="{{ path('blog_article', {'slug': article.alternateSlug ?: article.slug, '_locale': 'pl'}) }}" hreflang="pl">PL</a>
  {% endif %}
{% endblock %}
{% block body %}
<article class="article-shell">
  <header class="article-header">
    <p class="article-kicker">{{ article.category|upper }} · {{ article.readTimeMinutes }} MIN READ · {{ article.publishedAt|date('F d, Y')|upper }}</p>
    <h1>{{ article.title }}</h1>
    <p class="article-dek">{{ article.description }}</p>
    <div class="article-header-meta"><span>StackHal Field Notes</span><span>Updated {{ article.updatedAt|date('F d, Y') }}</span></div>
  </header>
  <div class="article-layout">
    {% set externalCta = article.ctaPath starts with 'https://' %}
    <aside class="article-toc" aria-label="On this page"><span>ON THIS PAGE</span><a href="#article-content">Article content</a><a href="#article-cta">Use the tool</a></aside>
    <div class="article-prose article-content" id="article-content">{{ article.contentHtml|raw }}</div>
    <aside class="article-sidebar">
      <div class="article-cta-card" id="article-cta">
        <p class="article-kicker">RELATED TOOL</p>
        <h2>Test this directly in your browser.</h2>
        <p>Run the check against your own domain or configuration without installing additional CLI tools.</p>
        <a class="cta-button" href="{{ article.ctaPath }}"{% if externalCta %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ article.ctaLabel }}</a>
      </div>
      <div class="article-author-card">
        <p class="article-kicker">AUTHOR &amp; CONTEXT</p>
        <p>Published by <strong>Bahdan Hal</strong> on StackHal. Built for engineers diagnosing subtle infrastructure, DNS, and deliverability bugs.</p>
      </div>
    </aside>
  </div>
</article>
{% endblock %}
{% block scripts %}<script src="/blog.js" defer></script>{% endblock %}
