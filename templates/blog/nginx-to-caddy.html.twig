{% block head_scripts %}<script type="application/ld+json">{{ {'@context':'https://schema.org','@graph':[{'@type':'Article','@id':'https://stackhal.com/blog/nginx-to-caddy#article','headline':'Nginx to Caddy Migration: Common Rewrite Rules and Hidden Traps','description':'A practical guide to translating Nginx reverse proxy configuration into Caddyfile syntax.','datePublished':'2026-08-28','dateModified':'2026-08-28','author':{'@id':'https://stackhal.com/#stackhal'},'publisher':{'@id':'https://stackhal.com/#stackhal'},'mainEntityOfPage':'https://stackhal.com/blog/nginx-to-caddy','inLanguage':'en'},{'@type':'HowTo','@id':'https://stackhal.com/blog/nginx-to-caddy#howto','name':'Migrate an Nginx site to Caddy','step':[{'@type':'HowToStep','name':'Map the site address','text':'Convert the server_name and listen directives into a site address at the top of the Caddyfile.'},{'@type':'HowToStep','name':'Translate matchers','text':'Map location blocks to path or named matchers and keep specific paths before broad ones.'},{'@type':'HowToStep','name':'Translate proxy behavior','text':'Use reverse_proxy and header_up for upstream routing and forwarded request headers.'},{'@type':'HowToStep','name':'Validate and reload','text':'Run caddy validate, compare headers and redirects, then reload with a rollback ready.'}]}]}|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>{% endblock %}
