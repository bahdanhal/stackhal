{% extends 'base.html.twig' %}
{% block title %}StackHal Blog · Practical Guides for Web Infrastructure{% endblock %}
{% block robots %}<meta name="robots" content="index,follow">{% endblock %}
{% block description %}<meta name="description" content="Practical guides for email authentication, DNS, technical SEO, and developer infrastructure from StackHal.">{% endblock %}
{% block canonical %}<link rel="canonical" href="https://stackhal.com/blog">{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/blog.css">{% endblock %}
{% block language_switch %}<a class="language-switch" href="{{ path('landing', {_locale: 'pl'}) }}" hreflang="pl">PL</a>{% endblock %}
{% block body %}
<section class="blog-index-shell">
  <div class="blog-index-intro">
    <p class="article-kicker">STACKHAL FIELD NOTES</p>
    <h1>Practical guides for the parts of the web that usually break quietly.</h1>
    <p class="article-dek">Short, evidence-led explainers for email authentication, DNS, technical SEO, and developer infrastructure.</p>
  </div>
  <a class="article-card" href="{{ path('blog_bimi_not_working') }}">
    <div class="article-card-visual" aria-hidden="true"><span>v=BIMI1</span><span>p=reject</span><span>SVG Tiny PS</span></div>
    <div class="article-card-copy">
      <p class="article-kicker">EMAIL AUTHENTICATION · 8 MIN READ</p>
      <h2>BIMI Not Working? A Practical Guide to DMARC, SVG Tiny PS, DNS Records, and VMC</h2>
      <p>Your logo is uploaded, the TXT record exists, and the inbox is still blank. Here is the shortest path from a confusing BIMI setup to a testable diagnosis.</p>
      <strong>Read the guide →</strong>
    </div>
  </a>
  <a class="article-card" href="{{ path('blog_nginx_to_caddy') }}">
    <div class="article-card-visual article-card-visual-caddy" aria-hidden="true"><span>location /api/</span><span>reverse_proxy</span><span>header_up Host</span></div>
    <div class="article-card-copy">
      <p class="article-kicker">REVERSE PROXIES · 9 MIN READ</p>
      <h2>Nginx to Caddy Migration: Common Rewrite Rules and Hidden Traps</h2>
      <p>Translate the directives that look obvious, then catch the path, header, and redirect semantics that can quietly change in production.</p>
      <strong>Read the guide →</strong>
    </div>
  </a>
  <a class="article-card" href="{{ path('blog_dns_delegation_explained') }}">
    <div class="article-card-visual article-card-visual-dns" aria-hidden="true"><span>root → .com</span><span>NS → auth</span><span>DNSSEC ✓</span></div>
    <div class="article-card-copy">
      <p class="article-kicker">DNS · 8 MIN READ</p>
      <h2>DNS Delegation Explained: From Root to Authoritative Nameserver</h2>
      <p>Follow one DNS lookup across recursive resolution, delegation, glue, authoritative data, and DNSSEC without treating the system like a black box.</p>
      <strong>Read the guide →</strong>
    </div>
  </a>
  <a class="article-card" href="{{ path('blog_pkpass_signature_errors') }}">
    <div class="article-card-visual article-card-visual-pkpass" aria-hidden="true"><span>manifest.json</span><span>SHA-1 ✓</span><span>signature PKCS#7</span></div>
    <div class="article-card-copy">
      <p class="article-kicker">APPLE WALLET · 7 MIN READ</p>
      <h2>PKPass Signature Errors: What to Check Before Rebuilding the Bundle</h2>
      <p>Use the bundle’s own evidence to separate a bad hash, a malformed signature, a broken certificate chain, and an invalid ZIP.</p>
      <strong>Read the guide →</strong>
    </div>
  </a>
</section>
{% endblock %}
