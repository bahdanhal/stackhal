parameters:
    level: 8
    paths:
        - src
        - tests
    scanFiles:
        - migrations/Version20261002180000.php
        - migrations/Version20260917120000.php
        - migrations/Version20260917220000.php
        - migrations/Version20260917233000.php
        - migrations/Version20260927120000.php
        - migrations/Version20261002210000.php
    excludePaths:
        - tests/bootstrap.php
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '#^Property App\\Entity\\[A-Za-z]+Entity\:\:\$id \(int\|null\) is never assigned int#'
            identifier: property.unusedType
